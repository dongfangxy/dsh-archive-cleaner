{
  "name": "dsh-archive-cleaner",
  "version": "0.1.0",
  "description": "DeepSeek Harness bundle: list archived sessions from a Tools entry at the sidebar foot and move the selected ones to a quarantine folder.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "sessions",
    "cleanup",
    "archive"
  ],
  "author": "Chengxi Zhang (https://github.com/dongfangxy)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongfangxy/dsh-archive-cleaner.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
